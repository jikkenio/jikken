---
import { FileTabs } from "./FileTabs";
import { RequestBar } from "./request/RequestBar";
import { RequestTabs } from "./request/RequestTabs";
import { ResponseTabs } from "./response/ResponseTabs";
import { $layoutState, ViewMode } from "../../stores/layoutState";
import { YamlView } from "./YamlView";
---

<div class="size-full flex flex-col">
  <FileTabs client:load />
  <div
    id="api-view"
    class="flex flex-col flex-auto"
    class:list={[{ hidden: $layoutState.value?.viewMode !== ViewMode.API }]}
  >
    <RequestBar client:only />
    <div class="flex flex-col flex-auto">
      <div id="request-panel" class="flex-none">
        <RequestTabs client:only />
      </div>
      <div class="flex-auto">
        <ResponseTabs client:only />
      </div>
    </div>
  </div>
  <div
    id="yaml-view"
    class="flex flex-auto"
    class:list={[{ hidden: $layoutState.value?.viewMode !== ViewMode.RAW }]}
  >
    <YamlView client:only />
  </div>
</div>

<script>
  import { listenKeys } from "nanostores";
  import { saveFile } from "../../stores/editorState";
  import {
    $layoutState,
    setRequestTabVisible,
    setResponseTabVisible,
    ViewMode,
  } from "../../stores/layoutState";

  const initializePage = () => {
    const elem = document.getElementById("tab-content");
    const resizer = document.getElementById("file-resizer");
    const main = document.getElementById("main-panel");
    
    // Set initial height for request panel
    const requestPanel = document.getElementById("request-panel");
    if (requestPanel) {
      requestPanel.style.height = "300px";  // Default height
    }

    let y = 0;
    let h = 0;

    document.addEventListener("keydown", (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key === "s") {
        e.preventDefault();
        saveFile();
      }
    });

    const mouseDownHandler = function (e: MouseEvent) {
      if (!elem) return;

      y = e.clientY;
      const styles = window.getComputedStyle(elem);
      h = parseInt(styles.height, 10);

      document.addEventListener("mousemove", mouseMoveHandler);
      document.addEventListener("mouseup", mouseUpHandler);

      resizer?.classList.add("border-indigo-400", "border-t-4");
      main?.classList.add("cursor-row-resize");
    };

    const mouseMoveHandler = function (e: MouseEvent) {
      if (!elem) return;

      let dy = e.clientY - y;
      let computedHeight = h + dy;
      elem.style.height = `${computedHeight}px`;

      if ($layoutState.value?.requestTabPanelVisible && computedHeight < 100) {
        setRequestTabVisible(false);
      } else if (
        !$layoutState.value?.requestTabPanelVisible &&
        computedHeight >= 100
      ) {
        setRequestTabVisible(true);
      }
    };

    const mouseUpHandler = function () {
      resizer?.classList.remove("border-indigo-400", "border-t-4");
      main?.classList.remove("cursor-row-resize");
      document.removeEventListener("mousemove", mouseMoveHandler);
      document.removeEventListener("mouseup", mouseUpHandler);
    };

    resizer?.addEventListener("mousedown", mouseDownHandler);

    // Response panel resizer - resizes the request panel above it
    let responseY = 0;
    let requestH = 0;
    let initialAvailableHeight = 0;
    let responseResizerAttached = false;

    const responseMouseDownHandler = function (e: MouseEvent) {
      const requestPanel = document.getElementById("request-panel");
      if (!requestPanel) return;

      responseY = e.clientY;
      const styles = window.getComputedStyle(requestPanel);
      requestH = parseInt(styles.height, 10);

      // Capture the available height at the start of the drag
      const apiView = document.getElementById("api-view");
      if (apiView) {
        const requestBarHeight = 80; // Approximate RequestBar height
        initialAvailableHeight = apiView.getBoundingClientRect().height - requestBarHeight;
      }

      document.addEventListener("mousemove", responseMouseMoveHandler);
      document.addEventListener("mouseup", responseMouseUpHandler);

      const responseResizer = document.getElementById("response-resizer");
      responseResizer?.classList.add("border-indigo-400", "border-t-4");
      main?.classList.add("cursor-row-resize");
    };

    const responseMouseMoveHandler = function (e: MouseEvent) {
      const requestPanel = document.getElementById("request-panel");
      if (!requestPanel) return;

      let dy = e.clientY - responseY;  // Positive dy means dragging down (expanding request panel)
      let computedHeight = requestH + dy;
      
      // Use the captured available height from mousedown
      const minRequestHeight = 250;  // Minimum height for request panel
      const minResponseHeight = 250; // Minimum height for response panel
      const maxRequestHeight = initialAvailableHeight - minResponseHeight;
      
      console.log('Initial available height:', initialAvailableHeight, 'Max request height:', maxRequestHeight, 'Computed height:', computedHeight);
      
      // Enforce minimum and maximum constraints
      if (computedHeight < minRequestHeight) {
        computedHeight = minRequestHeight;
      } else if (computedHeight > maxRequestHeight && maxRequestHeight > minRequestHeight) {
        computedHeight = maxRequestHeight;
        console.log('Clamped to max height:', computedHeight);
      }
      
      requestPanel.style.height = `${computedHeight}px`;
    };

    const responseMouseUpHandler = function () {
      const responseResizer = document.getElementById("response-resizer");
      responseResizer?.classList.remove("border-indigo-400", "border-t-4");
      main?.classList.remove("cursor-row-resize");
      document.removeEventListener("mousemove", responseMouseMoveHandler);
      document.removeEventListener("mouseup", responseMouseUpHandler);
    };

    // Check periodically for the response resizer and attach event listener when it appears
    const attachResponseResizer = () => {
      if (!responseResizerAttached) {
        const responseResizer = document.getElementById("response-resizer");
        if (responseResizer) {
          responseResizer.addEventListener("mousedown", responseMouseDownHandler);
          responseResizerAttached = true;
        }
      }
    };

    // Use MutationObserver to detect when response panel appears
    const observer = new MutationObserver(() => {
      attachResponseResizer();
    });

    // Start observing the document body for changes
    observer.observe(document.body, {
      childList: true,
      subtree: true
    });

    // Also try to attach immediately in case it's already there
    attachResponseResizer();
  };

  listenKeys($layoutState, ["viewMode"], (layout) => {
    const apiView = document.getElementById("api-view");
    const yamlView = document.getElementById("yaml-view");
    switch (layout.viewMode) {
      case ViewMode.API:
        apiView?.classList.remove("hidden");
        yamlView?.classList.add("hidden");
        break;
      case ViewMode.RAW:
        yamlView?.classList.remove("hidden");
        apiView?.classList.add("hidden");
        break;
      case ViewMode.TEST:
        apiView?.classList.add("hidden");
        yamlView?.classList.add("hidden");
        break;
      default:
    }
  });

  initializePage();
</script>

<style>
  * {
    --jse-font-size: 10px;
    --jse-font-size-mono: 12px;
  }
</style>
