---
import { FileTabs } from "./FileTabs";
import { RequestBar } from "./api/request/RequestBar";
import { RequestTabs } from "./api/request/RequestTabs";
import { ResponseTabs } from "./api/response/ResponseTabs";
import { $layoutState } from "../../stores/layoutState";
import { YamlView } from "./api/YamlView";
import { EntityType, ViewMode } from "../../stores/enum";
import { $editorState } from "../../stores/editorState";
import { ConfigView } from "./config/ConfigView";
import { TomlView } from "./api/TomlView";

let editorState = $editorState.value;
let currentFile = editorState?.files[editorState.currentFile];
---

<div class="size-full flex flex-col overflow-hidden">
  <FileTabs client:only />
  <div
    id="test-view"
    class="flex flex-auto min-w-0 overflow-hidden"
    class:list={[{ hidden: currentFile?.type !== EntityType.Test }]}
  >
    <div
      id="test-api-view"
      class="flex flex-col flex-auto min-w-0 min-h-0 overflow-hidden"
      class:list={[{ hidden: $layoutState.value?.viewMode !== ViewMode.API }]}
    >
      <RequestBar client:only />
      <div
        id="api-view"
        class="flex flex-col flex-auto min-w-0 min-h-0 overflow-hidden"
      >
        <div id="request-panel" class="min-w-0 min-h-0 overflow-hidden w-full">
          <RequestTabs client:only />
        </div>
        <div id="response-panel" class="min-w-0 min-h-0 overflow-hidden">
          <ResponseTabs client:only />
        </div>
      </div>
    </div>
    <div
      id="yaml-view"
      class="flex flex-auto"
      class:list={[{ hidden: $layoutState.value?.viewMode !== ViewMode.RAW }]}
    >
      <YamlView client:only />
    </div>
  </div>
  <div
    id="config-view"
    class="flex flex-auto"
    class:list={[{ hidden: currentFile?.type !== EntityType.Config }]}
  >
    <div
      id="config-api-view"
      class="flex flex-auto"
      class:list={[{ hidden: $layoutState.value?.viewMode !== ViewMode.API }]}
    >
      <ConfigView client:only />
    </div>
    <div
      id="toml-view"
      class="flex flex-auto"
      class:list={[{ hidden: $layoutState.value?.viewMode !== ViewMode.RAW }]}
    >
      <TomlView client:only />
    </div>
  </div>
</div>

<script>
  import { listenKeys } from "nanostores";
  import { $editorState, saveFile } from "../../stores/editorState";
  import { $layoutState } from "../../stores/layoutState";
  import { EntityType, ViewMode } from "../../stores/enum";
  import Split from "split.js";

  let requestResponseSplit: any = null;

  const initializeRequestResponseSplit = () => {
    const requestPanel = document.getElementById("request-panel");
    const responsePanel = document.getElementById("response-panel");

    if (requestPanel && responsePanel && !requestResponseSplit) {
      try {
        requestResponseSplit = Split(["#request-panel", "#response-panel"], {
          direction: "vertical",
          sizes: [40, 60], // Start with 40% request, 60% response
          minSize: [100, 100],
          gutterSize: 2,
          cursor: "row-resize",
          onDrag: () => {
            // Trigger Monaco resize when Split.js resizes panels
            window.dispatchEvent(new Event("resize"));
          },
          onDragEnd: () => {
            setTimeout(() => {
              window.dispatchEvent(new Event("resize"));
            }, 100);
          },
        });
      } catch (error) {
        console.error("Failed to initialize Split.js:", error);
      }
    }
  };

  // Make the function globally available
  window.initializeRequestResponseSplit = initializeRequestResponseSplit;

  const initializePage = () => {
    // Add keyboard shortcut for save
    document.addEventListener("keydown", (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key === "s") {
        e.preventDefault();
        saveFile();
      }
    });

    // Try to initialize with multiple attempts
    setTimeout(initializeRequestResponseSplit, 100);
    setTimeout(initializeRequestResponseSplit, 500);
    setTimeout(initializeRequestResponseSplit, 1000);
    setTimeout(initializeRequestResponseSplit, 2000);

    // Use MutationObserver to catch when panels are added to DOM
    const observer = new MutationObserver(() => {
      if (!requestResponseSplit) {
        initializeRequestResponseSplit();
      }
    });

    observer.observe(document.body, {
      childList: true,
      subtree: true,
    });
  };

  listenKeys($layoutState, ["viewMode"], (layout) => {
    const testApiView = document.getElementById("test-api-view");
    const configApiView = document.getElementById("config-api-view");
    const yamlView = document.getElementById("yaml-view");
    const tomlView = document.getElementById("toml-view");
    switch (layout.viewMode) {
      case ViewMode.API:
        testApiView?.classList.remove("hidden");
        configApiView?.classList.remove("hidden");
        yamlView?.classList.add("hidden");
        tomlView?.classList.add("hidden");
        break;
      case ViewMode.RAW:
        yamlView?.classList.remove("hidden");
        tomlView?.classList.remove("hidden");
        testApiView?.classList.add("hidden");
        configApiView?.classList.add("hidden");
        break;
      case ViewMode.TEST:
        testApiView?.classList.add("hidden");
        configApiView?.classList.add("hidden");
        yamlView?.classList.add("hidden");
        tomlView?.classList.add("hidden");
        break;
      default:
    }
  });

  $editorState.subscribe((state) => {
    const testView = document.getElementById("test-view");
    const configView = document.getElementById("config-view");
    const currentFile = state.files[state.currentFile];
    switch (currentFile.type) {
      case EntityType.Test:
        testView?.classList.remove("hidden");
        configView?.classList.add("hidden");
        break;
      case EntityType.Config:
        configView?.classList.remove("hidden");
        testView?.classList.add("hidden");
        break;
      default:
        testView?.classList.add("hidden");
        configView?.classList.add("hidden");
    }
  });

  initializePage();
</script>

<style>
  * {
    --jse-font-size: 10px;
    --jse-font-size-mono: 12px;
  }

  /* Split.js CSS moved to global Layout.astro */
</style>
